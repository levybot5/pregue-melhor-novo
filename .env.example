# Supabase (usado por src/services/database)
# URL e anon key: Project Settings > API, no painel do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usada SOMENTE em src/services/database/admin-client.ts (ignora RLS).
# Hoje: webhooks do Mercado Pago e da Asaas, e o fluxo de compra/trial
# (pending_purchases). Nunca importar fora de código server-only,
# nunca NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL pública e server-only usada para montar o back_url do checkout
# da Mercado Pago (ex.: https://app.pregue-melhor.com, ou o túnel
# público em desenvolvimento). Sem NEXT_PUBLIC_ de propósito.
APP_URL=http://localhost:3000

# Gemini (usado por src/services/ai) — server-only, nunca NEXT_PUBLIC_.
GEMINI_API_KEY=

# Mercado Pago (usado por src/services/billing/providers/mercadopago)
# — todas server-only, nunca NEXT_PUBLIC_. Access token e plan id: em
# Suas Integrações > Credenciais / Assinaturas. Webhook secret: em
# Suas Integrações > Webhooks > Configurar notificações.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_PLAN_ID=

# Asaas (usado por src/services/billing/providers/asaas) — checkout
# hospedado de PIX e cartão. Todas server-only, nunca NEXT_PUBLIC_.
#
# ASAAS_API_KEY: painel Asaas > Integrações > API > Gerar nova chave.
# Gere a chave no MESMO ambiente do valor abaixo (sandbox ou produção)
# — misturar os dois dá erro de autenticação.
#
# ASAAS_WEBHOOK_TOKEN: ao contrário da chave de API, este token você
# quem inventa (32-255 caracteres, sem espaços, nada óbvio tipo
# "12345") — cole o MESMO valor aqui e no painel Asaas, em
# Integrações > Webhooks > (criar/editar) > Token de autenticação. A
# Asaas devolve esse token em todo POST pro nosso endpoint; é assim
# que validamos que a notificação é legítima.
#
# ASAAS_ENVIRONMENT: "sandbox" ou "production". Sem valor = sandbox
# (nunca aponta pra produção por padrão, de propósito).
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENVIRONMENT=sandbox
