# Supabase (usado por src/services/database)
# URL e anon key: Project Settings > API, no painel do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reservada para uso futuro em código server-only (nunca no frontend).
# Não é usada nesta etapa.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini (usado por src/services/ai) — server-only, nunca NEXT_PUBLIC_.
GEMINI_API_KEY=
